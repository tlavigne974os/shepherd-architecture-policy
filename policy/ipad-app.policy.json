{
  "version": 1,
  "comment": "Architecture boundary for the Baxter iPad app. App code must not acquire hardware, open network paths, write durable state or create log sinks itself; it uses the BaxterMiddlewareKernel operations. Edited only through an owner-approved policy release.",
  "app_zones": [
    "Frame/**"
  ],
  "linked_package_zones": [
    "Packages/BaxterVoiceEngine/**",
    "Packages/BaxterVoicePresentation/**",
    "Packages/TensorFlowLiteSwift/**",
    "Packages/TensorFlowLiteC/**"
  ],
  "kernel_zones": [
    "Packages/BaxterMiddlewareKernel/**"
  ],
  "excluded": [
    "**/.build/**",
    "Packages/*/Tests/**",
    "Frame/**/*.md"
  ],
  "protected_paths": [
    "tools/architecture-policy/**",
    "tools/architecture-policy.pin",
    ".github/workflows/architecture-check.yml",
    ".github/CODEOWNERS",
    "Packages/BaxterMiddlewareKernel/**"
  ],
  "dependencies": {
    "app_targets": [
      "BaxterToo",
      "BaxterTooRestricted",
      "CaptureWitnessObservation"
    ],
    "allowed_app_products": [
      "BaxterMiddlewareKernel",
      "BaxterVoiceEngine",
      "BaxterVoicePresentation",
      "ChessKit"
    ],
    "kernel_only_products": [
      "CocoaMQTT",
      "OpenTelemetryApi",
      "OpenTelemetrySdk",
      "OpenTelemetryProtocolExporterHTTP"
    ],
    "route": "Add the capability to Packages/BaxterMiddlewareKernel and call the kernel operation; do not link an I/O library from the app."
  },
  "allowed_sites": [
    {
      "file": "Packages/TensorFlowLiteC/Package.swift",
      "rule": "package-build-input",
      "match": "binaryTarget",
      "note": "vendored TensorFlow Lite C xcframework (Google binary); named in allowed_binary_artifacts"
    },
    {
      "file": "Packages/BaxterVoiceEngine/Dependencies/TensorFlowLiteC/Package.swift",
      "rule": "package-build-input",
      "match": "binaryTarget",
      "note": "second vendored copy of the same xcframework package"
    },
    {
      "file": "Packages/TensorFlowLiteSwift/Sources/TensorFlowLite/tensorflow/lite/swift/Sources/Interpreter.swift",
      "rule": "logging",
      "match": "print (",
      "note": "vendored TensorFlow Lite error-reporter callback (stdout only, no log sink)"
    },
    {
      "file": "Packages/BaxterVoiceEngine/Dependencies/TensorFlowLiteSwift/Sources/TensorFlowLite/tensorflow/lite/swift/Sources/Interpreter.swift",
      "rule": "logging",
      "match": "print (",
      "note": "second vendored copy of the same wrapper"
    }
  ],
  "rules": [
    {
      "id": "hardware-audio",
      "category": "hardware",
      "route": "Use KernelAudioIO / KernelPCMRenderer / KernelTonePlayer from BaxterMiddlewareKernel; capture only starts under a CaptureGovernor lease.",
      "symbols": [
        "AVAudioSession",
        "AVAudioEngine",
        "AVAudioPlayer",
        "AVAudioPlayerNode",
        "AVAudioRecorder",
        "AVAudioSinkNode",
        "AVAudioSourceNode",
        "AVAudioInputNode",
        "AVAudioOutputNode",
        "AVAudioUnit",
        "AVAudioApplication",
        "AVAudioRoutingArbiter",
        "AVSpeechSynthesizer",
        "AVAssetWriter",
        "AVAssetReader",
        "AudioUnit",
        "AudioComponent",
        "AudioQueue",
        "SFSpeechRecognizer",
        "SFSpeechAudioBufferRecognitionRequest",
        "SFSpeechURLRecognitionRequest",
        "AVAudioFile"
      ],
      "call_symbols": [
        "AudioServicesPlaySystemSound"
      ]
    },
    {
      "id": "hardware-camera-sensors",
      "category": "hardware",
      "route": "Camera and sensors belong to the kernel; none is implemented today.",
      "symbols": [
        "AVCaptureSession",
        "AVCaptureDevice",
        "AVCaptureDeviceInput",
        "AVCapturePhotoOutput",
        "AVCaptureVideoDataOutput",
        "AVCaptureAudioDataOutput",
        "AVCaptureMovieFileOutput",
        "CMMotionManager",
        "CLLocationManager",
        "CBCentralManager",
        "CBPeripheralManager",
        "UIImagePickerController",
        "PHPickerViewController",
        "LAContext"
      ]
    },
    {
      "id": "hardware-media-playback",
      "category": "hardware",
      "route": "Use the kernel media player and its rendering surface.",
      "symbols": [
        "AVPlayer",
        "AVPlayerItem",
        "AVPlayerLayer",
        "AVQueuePlayer",
        "AVURLAsset",
        "AVAsset",
        "AVPlayerViewController",
        "MPVolumeView",
        "MPRemoteCommandCenter",
        "MPNowPlayingInfoCenter",
        "MPMusicPlayerController"
      ]
    },
    {
      "id": "hardware-display",
      "category": "hardware",
      "route": "Use KernelDisplay (brightness, idle timer).",
      "symbols": [
        "isIdleTimerDisabled",
        "UIScreen"
      ]
    },
    {
      "id": "network",
      "category": "network",
      "route": "Use a typed kernel transport; Baxter backend destinations only.",
      "symbols": [
        "URLSession",
        "URLSessionConfiguration",
        "URLSessionWebSocketTask",
        "URLSessionDataTask",
        "URLSessionDownloadTask",
        "URLSessionUploadTask",
        "URLSessionStreamTask",
        "NWConnection",
        "NWListener",
        "NWPathMonitor",
        "NWBrowser",
        "NWEndpoint",
        "CFSocket",
        "CFStream",
        "CFReadStream",
        "CFWriteStream",
        "CFHTTPMessage",
        "CFNetServiceBrowser",
        "NetService",
        "NetServiceBrowser",
        "MCSession",
        "MCNearbyServiceBrowser",
        "WKWebView",
        "WKWebViewConfiguration",
        "WKNavigationDelegate",
        "SFSafariViewController",
        "ASWebAuthenticationSession",
        "CocoaMQTT",
        "CocoaMQTT5",
        "OtlpHttpTraceExporter",
        "OtlpHttpMetricExporter",
        "OtlpHttpLogExporter",
        "NSURLConnection"
      ],
      "sequences": [
        "AsyncImage (",
        "Data ( contentsOf",
        "String ( contentsOf",
        "NSData ( contentsOf",
        "NSString ( contentsOf",
        "UIImage ( contentsOf"
      ],
      "call_symbols": [
        "socket",
        "getaddrinfo",
        "gethostbyname"
      ]
    },
    {
      "id": "persistence",
      "category": "persistence",
      "route": "Use the kernel preference/cache/credential APIs; durable business state belongs behind the backend.",
      "symbols": [
        "UserDefaults",
        "FileManager",
        "FileHandle",
        "NSFileCoordinator",
        "NSKeyedArchiver",
        "NSKeyedUnarchiver",
        "SecItemAdd",
        "SecItemCopyMatching",
        "SecItemUpdate",
        "SecItemDelete",
        "sqlite3_open",
        "sqlite3_exec",
        "NSPersistentContainer",
        "ModelContainer",
        "NSUbiquitousKeyValueStore",
        "InputStream",
        "OutputStream",
        "NSTemporaryDirectory",
        "CKContainer",
        "AppStorage",
        "SceneStorage"
      ],
      "sequences": [
        ". write ( to",
        ". write ( toFile",
        ". write ( contentsOf",
        "AppStorage (",
        "createFile ( atPath",
        "contentsOfFile :"
      ],
      "call_symbols": [
        "fopen",
        "fwrite",
        "open",
        "write",
        "mkstemp",
        "unlink",
        "rename",
        "mkdir",
        "rmdir"
      ]
    },
    {
      "id": "logging",
      "category": "logging",
      "route": "Use the kernel observation API; do not create log files or OS log handlers in app code.",
      "symbols": [
        "Logger",
        "OSLog",
        "OSSignposter",
        "os_signpost",
        "MXMetricManager",
        "OSLogStore",
        "SwiftLogger"
      ],
      "sequences": [
        "print (",
        "dump (",
        "FileHandle . standardError"
      ],
      "call_symbols": [
        "fputs",
        "setvbuf",
        "freopen",
        "os_log",
        "NSLog",
        "debugPrint"
      ]
    },
    {
      "id": "escape-routes",
      "category": "escape",
      "route": "Subprocess, dynamic-code and FFI routes are not allowed in app code.",
      "symbols": [
        "Process",
        "NSTask",
        "@_silgen_name",
        "@_cdecl",
        "@_dynamicReplacement",
        "NSExpression",
        "JSContext",
        "JSVirtualMachine",
        "NSAppleScript",
        "XPCSession",
        "NSXPCConnection"
      ],
      "call_symbols": [
        "posix_spawn",
        "posix_spawnp",
        "dlopen",
        "dlsym",
        "dlclose",
        "objc_getClass",
        "objc_msgSend",
        "popen",
        "system",
        "fork",
        "execv",
        "execve",
        "execvp",
        "NSClassFromString",
        "NSSelectorFromString"
      ]
    },
    {
      "id": "test-seam",
      "category": "test seam",
      "symbols": [
        "debugStubbed",
        "debugProtocolClasses",
        "unscopedWriterForTests"
      ],
      "route": "These exist only in DEBUG builds of the kernel for XCTest and must never be named by shipped code: tests build their own stubbed session or seeded store."
    },
    {
      "id": "package-build-input",
      "category": "build input",
      "symbols": [
        "unsafeFlags",
        "binaryTarget",
        "systemLibrary"
      ],
      "sequences": [
        ". plugin (",
        "plugins :",
        ". package ( url :"
      ],
      "route": "A package may not add unsafe compiler/linker flags, prebuilt binaries, build plugins, system libraries or remote dependencies on its own: they ship or run unscanned code. Name an exception exactly in allowed_sites through the owner-approved policy release."
    }
  ],
  "project_file": "BaxterToo.xcodeproj/project.pbxproj",
  "allowed_binary_artifacts": [
    "Packages/TensorFlowLiteC/Frameworks/TensorFlowLiteC.xcframework",
    "Packages/BaxterVoiceEngine/Dependencies/TensorFlowLiteC/Frameworks/TensorFlowLiteC.xcframework"
  ],
  "allowed_build_scripts": [
    {
      "sha256": "877138e33e1d524e161b91848c3e2563a9f6a9eae0d64e2b41e0f3a7d93feae8",
      "note": "capture-build.json generator (writes the installed source identity into the bundle); targets: BaxterToo"
    },
    {
      "sha256": "bbc9884cd419e0975280aebfdcb1d72784cd218d5577f567cd2e7b699de5b135",
      "note": "bundled canary SVG hash verification (build-time check only); targets: BaxterToo, BaxterTooRestricted"
    },
    {
      "sha256": "019600fa2e4ba22afc8d81ebb2f1719936877e7831d28d7554a6a8b05d2a1f5f",
      "note": "capture-build.json generator (writes the installed source identity into the bundle); targets: BaxterTooRestricted"
    }
  ]
}
